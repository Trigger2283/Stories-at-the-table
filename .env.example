# Local development only: copy to .env. Never commit real credentials.
# On Render, set these directly in Environment.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
CHAT_PASSWORD=replace-with-your-private-trial-password
# Only needed if frontend is hosted separately; use origins without URL paths.
FRONTEND_ORIGINS=
PORT=5001
